{
  "name": "labledger-server",
  "version": "1.0.0",
  "description": "LabLedger Backend API - Research Sample Tracking & Digital Logbook",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
